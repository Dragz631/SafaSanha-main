# ============================================================
# SafaSanha (LogiScan) - Variáveis de Ambiente
# ============================================================

# Chave de API do Google Gemini (OPCIONAL: só o endpoint de OCR por IA usa; ainda não há botão na interface)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Porta na qual o servidor Express irá escutar (Padrão: 3000)
PORT=3000

# Ambiente de execução ('production' ou 'development')
NODE_ENV=production

