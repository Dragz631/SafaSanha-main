# ============================================================
# SafaSanha (LogiScan) - Variáveis de Ambiente
# ============================================================

# Chave de API do Google Gemini (Obrigatória para OCR de etiquetas com IA)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Porta na qual o servidor Express irá escutar (Padrão: 3000)
PORT=3000

# Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# Diretório onde os dados e histórico de entregas serão salvos em formato JSON (Padrão: ./data)
# No Docker / TrueNAS, mapeie um volume para /app/data
DATA_DIR=/app/data
